# Copy to .env and configure a unique local password. Never commit .env.
APP_ENV=local
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=sales_assignment_local
DATABASE_USER=sales_assignment
DATABASE_PASSWORD=

# Optional notebook/model configuration.
LLM_API_URL=http://localhost:11434
LLM_MODEL=llama3.2:1b
LLM_TIMEOUT_SECONDS=600

# Generate two distinct random tokens; required by Compose.
DATABASE_API_TOKEN=
DATABASE_API_ADMIN_TOKEN=
DATABASE_API_URL=http://127.0.0.1:8001
DATABASE_API_PORT=8001
API_PORT=8000
LOCAL_UID=1001
LOCAL_GID=1001
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=30

# Frontend (local development; Compose uses http://api:8000)
API_BASE_URL=http://localhost:8000
FRONTEND_PORT=8501
# Longer timeout for optional AI explanations (note extraction keeps its own timeout).
OLLAMA_EXPLANATION_TIMEOUT_SECONDS=180

# Used automatically when the configured model does not exist in Ollama.
OLLAMA_DEFAULT_MODEL=llama3.2:1b
